# ==============================================================================
# BREAD & BITE - PRODUCTION SECURITY & CACHING HEADERS (NETLIFY)
# ==============================================================================

/*
  # 1. Anti-Clickjacking & Framing Protection (OWASP A05:2021)
  X-Frame-Options: DENY

  # 2. Prevent MIME Sniffing Vulnerabilities
  X-Content-Type-Options: nosniff

  # 3. Cross-Site Scripting (XSS) Filter Protection
  X-XSS-Protection: 1; mode=block

  # 4. Strict Referrer Policy
  Referrer-Policy: strict-origin-when-cross-origin

  # 5. Disable unused hardware permissions & tracking
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # 6. HTTP Strict Transport Security (HSTS - 1 Year)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # 7. Content Security Policy (CSP)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.ahrefs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://images.unsplash.com https://breadandbite.in; connect-src 'self' https://analytics.ahrefs.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me;

# Immutable Cache for Vite bundled hashed static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache policy for static images
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
